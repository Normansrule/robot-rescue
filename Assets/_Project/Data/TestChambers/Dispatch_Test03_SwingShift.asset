%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5976006531153724f8306a1fd441aa0c, type: 3}
  m_Name: Dispatch_Test03_SwingShift
  m_EditorClassIdentifier: RobotRescue.Runtime::RobotRescue.Narrative.DispatchScript
  lines:
  - cue: intro
    text: 'Test three: the Swing Shift. Hooks, a big pit, and a drone stuck on an island. Rescue him. That''s literally the job.'
    duration: 7
    repeatable: 0
  - cue: tether_swing
    text: Wheee! Sorry. Professional wheee. Q and Z reel the cable in and out.
    duration: 5
    repeatable: 0
  - cue: island
    text: Made it! Say hi to the drone. Then think about how you're both getting across.
    duration: 5
    repeatable: 0
  - cue: far_side
    text: Other side! Now, about our little friend. You can pull things from a distance, remember?
    duration: 6
    repeatable: 0
  - cue: tether_pull
    text: Incoming drone!
    duration: 3
    repeatable: 0
  - cue: plate_too_light
    text: You're not heavy enough for that plate. The drone is. Just saying.
    duration: 5
    repeatable: 0
  - cue: door_open
    text: Plate's down, door's open, drone's rescued. Textbook.
    duration: 5
    repeatable: 0
  - cue: fell
    text: Splash! The pit's full of very soft water. Mostly soft. Try again.
    duration: 4
    repeatable: 1
  - cue: fell
    text: 'Bureau policy: if at first you don''t succeed, respawn.'
    duration: 4
    repeatable: 1
  - cue: exit
    text: Training complete! You're officially a Rescue Bot. Provisionally. Pending paperwork.
    duration: 6
    repeatable: 0
