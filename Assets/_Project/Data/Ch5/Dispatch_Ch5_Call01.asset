%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5976006531153724f8306a1fd441aa0c, type: 3}
  m_Name: Dispatch_Ch5_Call01
  m_EditorClassIdentifier: RobotRescue.Runtime::RobotRescue.Narrative.DispatchScript
  lines:
  - cue: intro
    text: 'PIP, welcome to the harbour! Ines says every hum rattles more cargo loose, and now the supply barge is listing. It needs ballast. There''s a Magnet on the stand by the gate: those metal crates are far too heavy to carry.'
    duration: 10
    repeatable: 0
  - cue: got_magnet
    text: The Magnet! Hold F (or B) next to anything metal and it floats along in front of you. Let go to drop it. Tab swaps tools.
    duration: 7
    repeatable: 0
  - cue: ballast_light
    text: That plate wants something heavy. A metal crate, say.
    duration: 3
    repeatable: 1
  - cue: barge_level
    text: Barge is level! Ines is giving you a very official salute.
    duration: 4
    repeatable: 0
  - cue: mast_light_on
    text: Mast light's on! Ships can see the barge again.
    duration: 4
    repeatable: 0
  - cue: hum_tremor_first
    text: There's the hum. Watch those crates!
    duration: 3
    repeatable: 0
  - cue: hum_tremor
    text: Hum!
    duration: 2
    repeatable: 1
  - cue: fell
    text: Splash! Harbour water is very good for the circuits. That's a lie. Out you come.
    duration: 4
    repeatable: 1
  - cue: exit
    text: Harbour sorted! Ines says the old Bureau cable runs from here straight out toward the Old Rig. Interesting.
    duration: 6
    repeatable: 0
